<?xml version='1.0' encoding='utf-8' ?>
<workbook source-build='2022.4.1' source-platform='win' version='18.1' xmlns:user='http://www.tableausoftware.com/xml/user'>
  <preferences>
    <color-palette name='EV Analytics Palette' type='regular'>
      <color>#00f0ff</color><color>#7928ca</color><color>#ff0080</color>
      <color>#10b981</color><color>#f59e0b</color><color>#3b82f6</color>
    </color-palette>
  </preferences>
  <datasources>
    <datasource caption='EV Market Data' inline='true' name='federated.1' version='18.1'>
      <connection class='federated'>
        <named-connections>
          <named-connection caption='ev_market_data' name='textscan.1'>
            <connection class='textscan' directory='C:/Users/HP/OneDrive/Desktop/data anlytics proj/data' filename='ev_market_data.csv' locale='en_US' separator=',' header-row='yes' />
          </named-connection>
        </named-connections>
        <relation connection='textscan.1' name='ev_market_data.csv' table='[ev_market_data.csv]' type='table'>
          <columns character-set='UTF-8' header='yes' locale='en_US' separator=','>
            <column datatype='string' name='Vehicle_ID' ordinal='0' />
            <column datatype='integer' name='Year' ordinal='1' />
            <column datatype='string' name='Manufacturer' ordinal='2' />
            <column datatype='string' name='Model_Name' ordinal='3' />
            <column datatype='string' name='Vehicle_Category' ordinal='4' />
            <column datatype='string' name='Battery_Technology' ordinal='5' />
            <column datatype='real' name='Battery_Capacity_kWh' ordinal='6' />
            <column datatype='integer' name='Driving_Range_km' ordinal='7' />
            <column datatype='integer' name='Base_Price_USD' ordinal='8' />
            <column datatype='integer' name='Units_Sold_Annual' ordinal='9' />
            <column datatype='integer' name='Annual_Revenue_USD' ordinal='10' />
            <column datatype='real' name='Customer_Rating' ordinal='11' />
            <column datatype='string' name='Manufacturing_Country' ordinal='12' />
            <column datatype='integer' name='Efficiency_Wh_per_km' ordinal='13' />
            <column datatype='integer' name='Charging_Speed_kW' ordinal='14' />
            <column datatype='integer' name='Fast_Charge_Time_min' ordinal='15' />
            <column datatype='real' name='CO2_Offset_Tons_Annual' ordinal='16' />
            <column datatype='integer' name='Safety_Rating_Stars' ordinal='17' />
            <column datatype='real' name='Price_per_km_USD' ordinal='18' />
            <column datatype='string' name='Market_Segment' ordinal='19' />
          </columns>
        </relation>
      </connection>
      <aliases enabled='yes' />
      <column caption='Vehicle ID' datatype='string' name='[Vehicle_ID]' role='dimension' type='nominal' />
      <column caption='Year' datatype='integer' name='[Year]' role='dimension' type='ordinal' />
      <column caption='Manufacturer' datatype='string' name='[Manufacturer]' role='dimension' type='nominal' />
      <column caption='Model Name' datatype='string' name='[Model_Name]' role='dimension' type='nominal' />
      <column caption='Vehicle Category' datatype='string' name='[Vehicle_Category]' role='dimension' type='nominal' />
      <column caption='Battery Technology' datatype='string' name='[Battery_Technology]' role='dimension' type='nominal' />
      <column caption='Manufacturing Country' datatype='string' name='[Manufacturing_Country]' role='dimension' type='nominal' />
      <column caption='Market Segment' datatype='string' name='[Market_Segment]' role='dimension' type='nominal' />
      <column caption='Battery Capacity (kWh)' datatype='real' name='[Battery_Capacity_kWh]' role='measure' type='quantitative' default-format='#,##0.0" kWh"' />
      <column caption='Driving Range (km)' datatype='integer' name='[Driving_Range_km]' role='measure' type='quantitative' default-format='#,##0" km"' />
      <column caption='Base Price (USD)' datatype='integer' name='[Base_Price_USD]' role='measure' type='quantitative' default-format='$#,##0' />
      <column caption='Units Sold Annual' datatype='integer' name='[Units_Sold_Annual]' role='measure' type='quantitative' default-format='#,##0' />
      <column caption='Annual Revenue (USD)' datatype='integer' name='[Annual_Revenue_USD]' role='measure' type='quantitative' default-format='$#,##0' />
      <column caption='Customer Rating' datatype='real' name='[Customer_Rating]' role='measure' type='quantitative' default-format='#0.00' />
      <column caption='CO2 Offset (Tons/yr)' datatype='real' name='[CO2_Offset_Tons_Annual]' role='measure' type='quantitative' />
      <column caption='Safety Rating Stars' datatype='integer' name='[Safety_Rating_Stars]' role='measure' type='quantitative' />
      <column caption='Efficiency (Wh/km)' datatype='integer' name='[Efficiency_Wh_per_km]' role='measure' type='quantitative' />
      <column caption='Charging Speed (kW)' datatype='integer' name='[Charging_Speed_kW]' role='measure' type='quantitative' />
      <column caption='Fast Charge Time (min)' datatype='integer' name='[Fast_Charge_Time_min]' role='measure' type='quantitative' />
      <column caption='Price per km (USD)' datatype='real' name='[Price_per_km_USD]' role='measure' type='quantitative' default-format='$#,##0.00"/km"' />
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name='1. Category Sales'>
      <table>
        <view>
          <datasources>
            <datasource caption='EV Market Data' name='federated.1' />
          </datasources>
          <datasource-dependencies datasource='federated.1'>
            <column datatype='string' name='[Vehicle_Category]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Units_Sold_Annual]' role='measure' type='quantitative' />
            <column-instance column='[Vehicle_Category]' derivation='None' name='[none:Vehicle_Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[Units_Sold_Annual]' derivation='Sum' name='[sum:Units_Sold_Annual:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
          </pane>
        </panes>
        <rows>[federated.1].[none:Vehicle_Category:nk]</rows>
        <cols>[federated.1].[sum:Units_Sold_Annual:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='2. Manufacturer Share'>
      <table>
        <view>
          <datasources>
            <datasource caption='EV Market Data' name='federated.1' />
          </datasources>
          <datasource-dependencies datasource='federated.1'>
            <column datatype='string' name='[Manufacturer]' role='dimension' type='nominal' />
            <column datatype='integer' name='[Units_Sold_Annual]' role='measure' type='quantitative' />
            <column-instance column='[Manufacturer]' derivation='None' name='[none:Manufacturer:nk]' pivot='key' type='nominal' />
            <column-instance column='[Units_Sold_Annual]' derivation='Sum' name='[sum:Units_Sold_Annual:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
          </pane>
        </panes>
        <rows>[federated.1].[none:Manufacturer:nk]</rows>
        <cols>[federated.1].[sum:Units_Sold_Annual:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='3. Battery Chemistry Trend'>
      <table>
        <view>
          <datasources>
            <datasource caption='EV Market Data' name='federated.1' />
          </datasources>
          <datasource-dependencies datasource='federated.1'>
            <column datatype='integer' name='[Year]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[Units_Sold_Annual]' role='measure' type='quantitative' />
            <column-instance column='[Year]' derivation='None' name='[none:Year:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Units_Sold_Annual]' derivation='Sum' name='[sum:Units_Sold_Annual:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Line' />
          </pane>
        </panes>
        <rows>[federated.1].[sum:Units_Sold_Annual:qk]</rows>
        <cols>[federated.1].[none:Year:ok]</cols>
      </table>
    </worksheet>
    <worksheet name='4. Price vs Driving Range'>
      <table>
        <view>
          <datasources>
            <datasource caption='EV Market Data' name='federated.1' />
          </datasources>
          <datasource-dependencies datasource='federated.1'>
            <column datatype='integer' name='[Base_Price_USD]' role='measure' type='quantitative' />
            <column datatype='integer' name='[Driving_Range_km]' role='measure' type='quantitative' />
            <column-instance column='[Base_Price_USD]' derivation='Avg' name='[avg:Base_Price_USD:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Driving_Range_km]' derivation='Avg' name='[avg:Driving_Range_km:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Circle' />
          </pane>
        </panes>
        <rows>[federated.1].[avg:Driving_Range_km:qk]</rows>
        <cols>[federated.1].[avg:Base_Price_USD:qk]</cols>
      </table>
    </worksheet>
    <worksheet name='5. CO2 Offset by Category'>
      <table>
        <view>
          <datasources>
            <datasource caption='EV Market Data' name='federated.1' />
          </datasources>
          <datasource-dependencies datasource='federated.1'>
            <column datatype='string' name='[Vehicle_Category]' role='dimension' type='nominal' />
            <column datatype='real' name='[CO2_Offset_Tons_Annual]' role='measure' type='quantitative' />
            <column-instance column='[Vehicle_Category]' derivation='None' name='[none:Vehicle_Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[CO2_Offset_Tons_Annual]' derivation='Sum' name='[sum:CO2_Offset_Tons_Annual:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
          </pane>
        </panes>
        <rows>[federated.1].[none:Vehicle_Category:nk]</rows>
        <cols>[federated.1].[sum:CO2_Offset_Tons_Annual:qk]</cols>
      </table>
    </worksheet>
  </worksheets>
  <windows>
    <window class='worksheet' maximized='true' name='1. Category Sales'>
      <cards>
        <edge name='left'>
          <strip size='160'>
            <card type='pages' />
            <card type='filters' />
            <card type='marks' />
          </strip>
        </edge>
        <edge name='top'>
          <strip size='31'>
            <card type='columns' />
          </strip>
          <strip size='31'>
            <card type='rows' />
          </strip>
        </edge>
      </cards>
    </window>
    <window class='worksheet' name='2. Manufacturer Share'>
      <cards>
        <edge name='left'>
          <strip size='160'>
            <card type='pages' />
            <card type='filters' />
            <card type='marks' />
          </strip>
        </edge>
        <edge name='top'>
          <strip size='31'>
            <card type='columns' />
          </strip>
          <strip size='31'>
            <card type='rows' />
          </strip>
        </edge>
      </cards>
    </window>
    <window class='worksheet' name='3. Battery Chemistry Trend'>
      <cards>
        <edge name='left'>
          <strip size='160'>
            <card type='pages' />
            <card type='filters' />
            <card type='marks' />
          </strip>
        </edge>
        <edge name='top'>
          <strip size='31'>
            <card type='columns' />
          </strip>
          <strip size='31'>
            <card type='rows' />
          </strip>
        </edge>
      </cards>
    </window>
    <window class='worksheet' name='4. Price vs Driving Range'>
      <cards>
        <edge name='left'>
          <strip size='160'>
            <card type='pages' />
            <card type='filters' />
            <card type='marks' />
          </strip>
        </edge>
        <edge name='top'>
          <strip size='31'>
            <card type='columns' />
          </strip>
          <strip size='31'>
            <card type='rows' />
          </strip>
        </edge>
      </cards>
    </window>
    <window class='worksheet' name='5. CO2 Offset by Category'>
      <cards>
        <edge name='left'>
          <strip size='160'>
            <card type='pages' />
            <card type='filters' />
            <card type='marks' />
          </strip>
        </edge>
        <edge name='top'>
          <strip size='31'>
            <card type='columns' />
          </strip>
          <strip size='31'>
            <card type='rows' />
          </strip>
        </edge>
      </cards>
    </window>
  </windows>
</workbook>

